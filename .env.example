# Copy to .env and fill in. NEVER commit .env.
# All values are for NEAR TESTNET. There is no mainnet configuration in this project.

# Account that deploys the contracts. Create it in a wallet first — do not invent one.
DEPLOYER_ACCOUNT=
# ed25519:<base58> private key for DEPLOYER_ACCOUNT. Keep this file out of git.
DEPLOYER_PRIVATE_KEY=

# Registry contract (created by the deploy script: charter.$DEPLOYER_ACCOUNT)
CHARTER_CONTRACT=

# RPC endpoint — testnet only
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_NETWORK=testnet

# Frontend (Vite) reads these; only public identifiers belong here.
VITE_NETWORK=testnet
VITE_CHARTER_CONTRACT=
